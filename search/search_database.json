teration integer , intent ( in ) :: iter !! iteration number real ( wp ), dimension (:), allocatable :: et integer :: k , nseg call me % mission % put_x_in_segments ( x ) ! (the segments' epochs for this iteration) nseg = size ( me % mission % segs ) allocate ( et ( nseg / 2 )) do k = 1 , nseg / 2 associate ( seg => me % mission % segs ( 2 * k - 1 )) et ( k ) = seg % data % et_ref + seg % data % tf * day2sec end associate end do call me % epoch_callback ( iter , et ) end subroutine iteration_epochs","tags":"","url":"proc/iteration_epochs.html"},{"title":"iteration_trajectory – halo","text":"public  subroutine iteration_trajectory(me, x, iter) Propagate the segments for the solver's current x , and send the trajectory\n(joined in time order) to the solver's iteration_callback . Arguments Type Intent Optional Attributes Name class( my_solver_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x the solver's (scaled) opt vars for this iteration integer, intent(in) :: iter iteration number Calls proc~~iteration_trajectory~~CallsGraph proc~iteration_trajectory iteration_trajectory proc~destroy_trajectory trajectory%destroy_trajectory proc~iteration_trajectory->proc~destroy_trajectory proc~propagate_segment segment%propagate_segment proc~iteration_trajectory->proc~propagate_segment proc~put_x_in_segments mission_type%put_x_in_segments proc~iteration_trajectory->proc~put_x_in_segments first_call first_call proc~propagate_segment->first_call icrf_frame icrf_frame proc~propagate_segment->icrf_frame integrate integrate proc~propagate_segment->integrate proc~identity_stm identity_stm proc~propagate_segment->proc~identity_stm proc~set_segment_outputs segment%set_segment_outputs proc~propagate_segment->proc~set_segment_outputs transform transform proc~propagate_segment->transform two_body_rotating_frame two_body_rotating_frame proc~propagate_segment->two_body_rotating_frame extract_vector extract_vector proc~put_x_in_segments->extract_vector proc~define_proble