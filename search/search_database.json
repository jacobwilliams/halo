e_scales mission_type%equilibrate_scales proc~equilibrate_scales->proc~compute_jacobian_stm proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~equilibrate proc~initialize_the_mission mission_type%initialize_the_mission proc~initialize_the_mission->proc~equilibrate_scales interface~eclipse_optimize my_solver_type%eclipse_optimize interface~eclipse_optimize->proc~eclipse_optimize proc~initialize_the_solver my_solver_type%initialize_the_solver proc~initialize_the_solver->proc~initialize_the_mission proc~halo_solver_main halo_solver_main proc~halo_solver_main->interface~eclipse_optimize proc~halo_solver_main->proc~initialize_the_solver Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine propagate_segment_stm ( me ) implicit none class ( segment ), intent ( inout ) :: me integer :: idid real ( wp ) :: t , t0 , tf , et0 , etf real ( wp ), dimension ( n_eoms_stm ) :: x real ( wp ), dimension ( 6 ) :: xf , xf_rotating , f0 , ff real ( wp ), dimension ( 6 , 6 ) :: phi , m_f , mdot_f , n_0 , ndot_0 type ( icrf_frame ) :: inertial type ( two_body_rotating_frame ) :: rotating logical :: status_ok if (. not . me % stm_mode ) error stop 'error: propagate_segment_stm requires stm_mode' t0 = me % data % t0 * day2sec ! initial time in seconds from epoch tf = me % data % tf * day2sec ! final time in seconds from epoch x ( 1 : n_eoms ) = me % data % x0 ! inertial state x ( n_eoms + 1 :) = identity_stm () ! integrate in local time (from 0 at t0), see t_offset: me % t_offset = t0 t = zero me % compute_stm = . true . call me % first_call () call me % integrate ( t , x ,( me % data % tf - me % data % t0 ) * day2sec , idid = idid , integration_mode = 1 ) me % compute_stm = . false . me % t_offset = zero ! (the calls below use the time from epoch) me % failed = . false . if ( idid < 0 ) then if ( me % soft_fail ) then me % failed = . true . me % dxf_dx0 = zero ; me % dxf_dt0 = zero ; me % dxf_dtf = zero return end if write ( * , '(A,*(I5/))' ) 'idid: ' , idid error stop 'error in integrator' end if xf = x ( 1 : n_eoms ) phi = reshape ( x ( n_eoms + 1 :), [ 6 , 6 ]) ! the final state in the rotating frame (as in propagate_segment): etf = me % data % et_ref + tf inertial = icrf_frame ( b = body_moon ) rotating = two_body_rotating_frame ( primary_body = body_earth ,& secondary_body = body_moon ,& center = center_at_secondary_body ,& et = etf ) call inertial % transform ( xf , rotating , etf , me % eph , xf_rotating , status_ok ) if (. not . status_ok ) error stop 'transformation error in propagate_segment_stm' call me % set_outputs ( xf , xf_rotating ) ! the frame transformations and their time derivatives: et0 = me % data % et_ref + t0 call earth_moon_frame_matrices ( me , et0 , n = n_0 , ndot = ndot_0 ) call earth_moon_frame_matrices ( me , etf , m = m_f , mdot = mdot_f ) ! equations of motion at the start and the end: call ballistic_derivs ( me , t0 , me % data % x0 , f0 ) call ballistic_derivs ( me , tf , xf , ff ) me % dxf_dx0 = matmul ( m_f , matmul ( phi , n_0 )) me % dxf_dt0 = matmul ( m_f , matmul ( phi , matmul ( ndot_0 , me % data % x0_rotating ) - f0 )) me % dxf_dtf = matmul ( mdot_f , xf ) + matmul ( m_f , ff ) end subroutine propagate_segment_stm","tags":"","url":"proc/propagate_segment_stm.html"},{"title":"earth_moon_frame_matrices – halo","text":"public  subroutine earth_moon_frame_matrices(seg, et, m, mdot, n, ndot) The Moon-centered Earth-Moon rotating frame transformations at et (and their\ntime derivatives), consistent with the toolkit's two_body_rotating_frame as used in set_segment_inputs and propagate_segment .\nRequires the splined ephemeris (for the time derivatives). Arguments Type Intent Optional Attributes Name class( segment ), intent(inout) :: seg real(kind=wp), intent(in) :: et ephemeris time [sec] real(kind=wp), intent(out), optional, dimension(6,6) :: m inertial to rotating real(kind=wp), intent(out), optional, dimension(6,6) :: mdot dm/dt real(kind=wp), intent(out), optional, dimension(6,6) :: n rotating to inertial real(kind=wp), intent(out), optional, dimension(6,6) :: ndot dn/dt Calls proc~~earth_moon_frame_matrices~~CallsGraph proc~earth_moon_frame_matrices earth_moon_frame_matrices get_rv get_rv proc~earth_moon_frame_matrices->get_rv get_rv_derivative get_rv_derivative proc~earth_moon_frame_matrices->get_rv_derivative proc~two_body_rotating_frame_matrices two_body_rotating_frame_matrices proc~earth_moon_frame_matrices->proc~two_body_rotating_frame_matrices proc~cross cross proc~two_body_rotating_frame_matrices->proc~cross proc~cross_matrix cross_matrix proc~two_body_rotating_frame_matrices->proc~cross_matrix Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~earth_moon_frame_matrices~~CalledByGraph proc~earth_moon_frame_matrices earth_moon_frame_matrices proc~compute_jacobian_stm mission_type%compute_jacobian_stm proc~compute_jacobian_stm->proc~earth_moon_frame_matrices proc~propagate_segment_stm segment%propagate_segment_stm proc~compute_jacobian_stm->proc~propagate_segment_stm proc~propagate_segment_stm->proc~earth_moon_frame_matrices proc~equilibrate equilibrate proc~equilibrate->proc~compute_jacobian_stm proc~equilibrate_scales mission_type%equilibrate_scales proc~equilibrate_scales->proc~compute_jacobian_stm proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~equilibrate proc~initialize_the_mission mission_type%initialize_the_mission proc~initialize_the_mission->proc~equilibrate_scales interface~eclipse_optimize my_solver_type%eclipse_optimize interface~eclipse_optimize->proc~eclipse_optimize proc~initialize_the_solver my_solver_type%initialize_the_solver proc~initialize_the_solver->proc~initialize_the_mission proc~halo_solver_main halo_solver_main proc~halo_solver_main->interface~eclipse_optimize proc~halo_solver_main->proc~initialize_the_solver Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine earth_moon_frame_matrices ( seg , et , m , mdot , n , ndot ) implicit none class ( segment ), intent ( inout ) :: seg real ( wp ), intent ( in ) :: et !! ephemeris time [sec] real ( wp ), dimension ( 6 , 6 ), intent ( out ), optional :: m !! inertial to rotating real ( wp ), dimension ( 6 , 6 ), intent ( out ), optional :: mdot !! dm/dt real ( wp ), dimension ( 6 , 6 ), intent ( out ), optional :: n !! rotating to inertial real ( wp ), dimension ( 6 , 6 ), intent ( out ), optional :: ndot !! dn/dt real ( wp ), dimension ( 6 ) :: rv , rvdot logical :: status_ok select type ( eph => seg % eph ) class is ( jpl_ephemeris_splined ) call eph % get_rv ( et , body_moon , body_earth , rv , status_ok ) ! (secondary w.r.t. primary) if ( status_ok ) call eph % get_rv_derivative ( et , body_moon , body_earth , rvdot , status_ok ) class default error stop 'error: earth_moon_frame_matrices requires the splined ephemeris' end select if (. not . status_ok ) error stop 'ephemeris error in earth_moon_frame_matrices' call two_body_rotating_frame_matrices ( rv , rvdot ( 1 : 3 ), rvdot ( 4 : 6 ), m , mdot , n , ndot ) end subroutine earth_moon_frame_matrices","tags":"","url":"proc/earth_moon_frame_matrices.html"},{"title":"segs_to_propagate – halo","text":"public  subroutine segs_to_propagate(me, funcs_to_compute, isegs_to_propagate) Given the functions to be computed, returns the segments that need to be propagated. Type Bound mission_type Arguments Type Intent Optional Attributes Name class( mission_type ), intent(inout) :: me integer, intent(in), optional, dimension(:) :: funcs_to_compute the indices of f to compute integer, intent(out), dimension(:), allocatable :: isegs_to_propagate segment numbers Calls proc~~segs_to_propagate~~CallsGraph proc~segs_to_propagate mission_type%segs_to_propagate proc~define_problem_size mission_type%define_problem_size proc~segs_to_propagate->proc~define_problem_size Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~segs_to_propagate~~CalledByGraph proc~segs_to_propagate mission_type%segs_to_propagate proc~constraint_violations mission_type%constraint_violations proc~constraint_violations->proc~segs_to_propagate proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~constraint_violations proc~halo_solver_main halo_solver_main proc~halo_solver_main->proc~constraint_violations proc~write_solution_plot_data mission_type%write_solution_plot_data proc~halo_solver_main->proc~write_solution_plot_data interface~eclipse_optimize my_solver_type%eclipse_optimize proc~halo_solver_main->interface~eclipse_optimize proc~write_solution_plot_data->proc~constraint_violations interface~eclipse_optimize->proc~eclipse_optimize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine segs_to_propagate ( me , funcs_to_compute , isegs_to_propagate ) implicit none class ( mission_type ), intent ( inout ) :: me integer , dimension (:), intent ( in ), optional :: funcs_to_compute !! the indices of f to compute integer , dimension (:), allocatable , intent ( out ) :: isegs_to_propagate !! segment numbers integer :: i , j !! counters integer :: m !! number of constraints ! In this example, there are no dependencies, so we assume they ! can be propagated in any order. if ( present ( funcs_to_compute )) then ! this is for the full \"forward-backward\" problem formulation: !                                               optional: !       1-6      7-12    13-19     20-26        [m] ! f = [xf1-xf2, xf3-xf4, xf5-xf6, xf7-xf8, ..., [rdot] ] ! !      0     1     2 ! f = [123456123456123456] ! ! 0: 1-2 ! 1: 3-4 ! 2: 5-6 ! 3: 7-8 if ( me % constrain_initial_rdot ) call me % define_problem_size ( m = m ) ! we need m below do i = 1 , size ( funcs_to_compute ) if ( me % constrain_initial_rdot ) then if ( funcs_to_compute ( i ) == m ) cycle ! for the rdot constraint, handle below separately end if j = ( funcs_to_compute ( i ) - 1 ) / 6 ! 0,1,2,... call add_it ( j * 2 + 1 , isegs_to_propagate ) ! ... is this correct ? call add_it ( j * 2 + 2 , isegs_to_propagate ) end do if ( me % constrain_initial_rdot ) then ! for the rdot constraint we have to propagate segment 1 if ( any ( m == funcs_to_compute )) then call add_it ( 1 , isegs_to_propagate ) end if end if else ! propagate all the segments: isegs_to_propagate = [( i , i = 1 , size ( me % segs ))] end if !write(*,*) '' !write(*,*) 'funcs_to_compute:',funcs_to_compute !write(*,*) '' !write(*,*) 'isegs_to_propagate:',isegs_to_propagate !write(*,*) '' contains !******************************** subroutine add_it ( segnum , array ) implicit none integer , intent ( in ) :: segnum integer , dimension (:), allocatable , intent ( inout ) :: array if ( allocated ( array )) then if (. not . any ( array == segnum )) then array = [ array , segnum ] end if else array = [ segnum ] ! auto LHS allocation end if end subroutine add_it !******************************** end subroutine segs_to_propagate","tags":"","url":"proc/segs_to_propagate.html"},{"title":"constraint_violations – halo","text":"public  subroutine constraint_violations(me, x, f, funcs_to_compute) Computes the constraint violation vector for the mission. Type Bound mission_type Arguments Type Intent Optional Attributes Name class( mission_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x opt var vector for the mission [n] real(kind=wp), intent(out), dimension(:) :: f constraint violation vector for the mission [m] integer, intent(in), optional, dimension(:) :: funcs_to_compute the indice