onfig_file ), intent ( inout ) :: me character ( len =* ), intent ( in ) :: name !! name of the variable real ( wp ), dimension (:), allocatable , intent ( inout ) :: variable !! the variable to populate with the value logical , intent ( out ), optional :: found !! if the variable was in the file real ( wp ), dimension (:), allocatable :: tmp logical :: required !! if the variable is required !! (if required and not found, `error stop` is called) logical :: was_found !! local copy of `found` required = . not . present ( found ) call me % json % get ( name , tmp , was_found ); if ( was_found ) variable = tmp if ( required . and . . not . was_found ) & error stop trim ( name ) // ' integer variable not found in config file: ' // trim ( me % name ) if ( present ( found )) found = was_found end subroutine get_real_vec","tags":"","url":"proc/get_real_vec.html"},{"title":"j2000_to_frame – halo","text":"private  function j2000_to_frame(me, et) result(rot) The rotation matrix from J2000 to the MOON_PA frame at et . Type Bound moon_pa_frame Arguments Type Intent Optional Attributes Name class( moon_pa_frame ), intent(inout) :: me real(kind=wp), intent(in) :: et ephemeris time [sec] Return Value real(kind=wp), dimension(3,3) Calls proc~~j2000_to_frame~~CallsGraph proc~j2000_to_frame moon_pa_frame%j2000_to_frame db1val db1val proc~j2000_to_frame->db1val proc~rpy_to_rot rpy_to_rot proc~j2000_to_frame->proc~rpy_to_rot Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~j2000_to_frame~~CalledByGraph proc~j2000_to_frame moon_pa_frame%j2000_to_frame proc~frame_to_j2000 moon_pa_frame%frame_to_j2000 proc~frame_to_j2000->proc~j2000_to_frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function j2000_to_frame ( me , et ) result ( rot ) class ( moon_pa_frame ), intent ( inout ) :: me real ( wp ), intent ( in ) :: et !! ephemeris time [sec] real ( wp ), dimension ( 3 , 3 ) :: rot real ( wp ), dimension ( n_splines ) :: v !! roll, pitch, cos(yaw), sin(yaw) integer :: j , iflag if ( nx == 0 ) error stop 'error: the MOON_PA frame has not been initialized' do j = 1 , n_splines call db1val ( et , 0 , tx (:, j ), nx , kx , bcoef (:, j ), v ( j ), iflag , me % inbvx ( j ), me % w0 , extrap = . false .) if ( iflag /= 0 ) error stop 'error evaluating the MOON_PA spline.' end do call rpy_to_rot ( v ( 1 ), v ( 2 ), atan2 ( v ( 4 ), v ( 3 )), rot ) end function j2000_to_frame","tags":"","url":"proc/j2000_to_frame.html"},{"title":"frame_to_j2000 – halo","text":"private  function frame_to_j2000(me, et) result(rot) The rotation matrix from the MOON_PA frame to J2000 at et . Type Bound moon_pa_frame Arguments Type Intent Optional Attributes Name class( moon_pa_frame ), intent(inout) :: me real(kind=wp), intent(in) :: et ephemeris time [sec] Return Value real(kind=wp), dimension(3,3) Calls proc~~frame_to_j2000~~CallsGraph proc~frame_to_j2000 moon_pa_frame%frame_to_j2000 proc~j2000_to_frame moon_pa_frame%j2000_to_frame proc~frame_to_j2000->proc~j2000_to_frame db1val db1val proc~j2000_to_frame->db1val proc~rpy_to_rot rpy_to_rot proc~j2000_to_frame->proc~rpy_to_rot Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code function frame_to_j2000 ( me , et ) result ( rot ) class ( moon_pa_frame ), intent ( inout ) :: me real ( wp ), intent ( in ) :: et !! ephemeris time [sec] real ( wp ), dimension ( 3 , 3 ) :: rot rot = transpose ( me % j2000_to_frame ( et )) end function frame_to_j2000","tags":"","url":"proc/frame_to_j2000.html"},{"title":"initialize_moon_pa_frame – halo","text":"private  subroutine initialize_moon_pa_frame(me, filename, et0, etf) Read the table and compute the (global) splines, for the time span [et0, etf] :\nthe rows from the last one at or before et0 to the first one at or after etf (as in moonframe ). Then the object's workspace is reset; copies of\nthe object ( allocate(..., source=...) ) can be used by other threads. Type Bound moon_pa_frame Arguments Type Intent Optional Attributes Name class( moon_pa_frame ), intent(inout) :: me character(len=*), intent(in) :: filename csv file with the ephemeris time, roll, pitch and yaw (rad) real(kind=wp), intent(in) :: et0 start ephemeris time of the span to spline [sec] real(kind=wp), intent(in) :: etf end ephemeris time of the span to spline [sec] Calls proc~~initialize_moon_pa_frame~~CallsGraph proc~initialize_moon_pa_frame moon_pa_frame%initialize_moon_pa_frame db1ink db1ink proc~initialize_moon_pa_frame->db1ink destroy destroy proc~initialize_moon_pa_frame->destroy get get proc~initialize_moon_pa_frame->get Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine initialize_moon_pa_frame ( me , filename , et0 , etf ) class ( moon_pa_frame ), intent ( inout ) :: me character ( len =* ), intent ( in ) :: filename !! csv file with the ephemeris time, roll, pitch and yaw (rad) real ( wp ), intent ( in ) :: et0 !! start ephemeris time of the span to spline [sec] real ( wp ), intent ( in ) :: etf !! end ephemeris time of the span to spline [sec] type ( csv_file ) :: f real ( wp ), dimension (:), allocatable :: et , roll , pitch , yaw , fcn integer :: n , istart , iend , i , j , iflag logical :: status_ok ! read the data from the csv file: call f % read ( filename , header_row = 1 , status_ok = status_ok ) if (. not . status_ok ) error stop 'error reading file: ' // trim ( filename ) call f % get ( 1 , et , status_ok ); if (. not . status_ok ) error stop 'error getting et from file: ' // trim ( filename ) call f % get ( 2 , roll , status_ok ); if (. not . status_ok ) error stop 'error getting roll from file: ' // trim ( filename ) call f % get ( 3 , pitch , status_ok ); if (. not . status_ok ) error stop 'error getting pitch from file: ' // trim ( filename ) call f % get ( 4 , yaw , status_ok ); if (. not . status_ok ) error stop 'error getting yaw from file: ' // trim ( filename ) call f % destroy () ! the rows to use (the span, with the rows just outside it): n = size ( et ) istart = minloc ( abs ( et - et0 ), 1 ) if ( et ( istart ) > et0 ) istart = max ( 1 , istart - 1 ) iend = minloc ( abs ( et - etf ), 1 ) if ( et ( iend ) < etf ) iend = min ( n , iend + 1 ) if ( et ( iend ) < et ( istart )) error stop 'Error: end time is before start time' ! the global splines. roll and pitch have no discontinuities; the yaw angle wraps ! around once per lunar rotation, so its cosine and sine are splined instead. if ( allocated ( tx )) deallocate ( tx ) if ( allocated ( bcoef )) deallocate ( bcoef ) nx = iend - istart + 1 allocate ( tx ( nx + kx , n_splines ), bcoef ( nx , n_splines ), fcn ( nx )) do j = 1 , n_splines do i = istart , iend ! (a loop: no large temporaries on the stack) select case ( j ) case ( 1 ); fcn ( i - istart + 1 ) = roll ( i ) case ( 2 ); fcn ( i - istart + 1 ) = pitch ( i ) case ( 3 ); fcn ( i - istart + 1 ) = cos ( yaw ( i )) case ( 4 ); fcn ( i - istart + 1 ) = sin ( yaw ( i )) end select end do call db1ink ( et ( istart : iend ), nx , fcn , kx , iknot , tx (:, j ), bcoef (:, j ), iflag ) if ( iflag /= 0 ) error stop 'error initializing the MOON_PA spline: ' // trim ( filename ) end do call me % destroy () ! (reset the workspace) end subroutine initialize_moon_pa_frame","tags":"","url":"proc/initialize_moon_pa_frame.html"},{"title":"rpy_to_rot – halo","text":"private pure subroutine rpy_to_rot(roll, pitch, yaw, r) Roll, pitch and yaw (rad) to the rotation matrix (as in moonframe ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: roll real(kind=wp), intent(in) :: pitch real(kind=wp), intent(in) :: yaw real(kind=wp), intent(out), dimension(3,3) :: r Called by proc~~rpy_to_rot~~CalledByGraph proc~rpy_to_rot rpy_to_rot proc~j2000_to_frame moon_pa_frame%j2000_to_frame proc~j2000_to_frame->proc~rpy_to_rot proc~frame_to_j2000 moon_pa_frame%frame_to_j2000 proc~frame_to_j2000->proc~j2000_to_frame Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine rpy_to_rot ( roll , pitch , yaw , r ) real ( wp ), intent ( in ) :: roll , pitch , yaw real ( wp ), dimension ( 3 , 3 ), intent ( out ) :: r real ( wp ) :: cr , sr , cp , sp , cy , sy cr = cos ( roll ) sr = sin ( roll ) cp = cos ( pitch ) sp = sin ( pitch ) cy = cos ( yaw ) sy = sin ( yaw ) r ( 1 , 1 ) = cy * cp r ( 1 , 2 ) = cy * sp * sr - sy * cr r ( 1 , 3 ) = cy * sp * cr + sy * sr r ( 2 , 1 ) = sy * cp r ( 2 , 2 ) = sy * sp * sr + cy * cr r ( 2 , 3 ) = sy * sp * cr - cy * sr r ( 3 , 1 ) = - sp r ( 3 , 2 ) = cp * sr r ( 3 , 3 ) = cp * cr end subroutine rpy_to_rot","tags":"","url":"proc/rpy_to_rot.html"},{"title":"destroy_moon_pa_frame – halo","text":"private  subroutine destroy_moon_pa_frame(me) Reset the object's workspace (the global splines are kept). Type Bound moon_pa_frame Arguments Type Intent Optional Attributes Name class( moon_pa_frame ), intent(inout) :: me Source Code subroutine destroy_moon_pa_frame ( me ) class ( moon_pa_frame ), intent ( inout ) :: me me % inbvx = 1 me % w0 = 0.0_wp end subroutine destroy_moon_pa_frame","tags":"","url":"proc/destroy_moon_pa_frame.html"},{"title":"removed_columns – halo","text":"public  function removed_columns(me) result(cols_to_remove) The columns (optimization variables) of the full problem that are removed\n(fixed) by the problem options. The full problem has 7 columns per node\n( [t, rx, ry, rz, vx, vy, vz] ), with nodes in time order. Type Bound mission_type Arguments Type Intent Optional Attributes Name class( mission_type ), i