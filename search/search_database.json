 proc~halo_solver_main->interface~eclipse_optimize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine find_rows ( mission , x , rows , phimin , shadow_min ) class ( mission_type ), intent ( inout ) :: mission real ( wp ), dimension (:), intent ( in ) :: x type ( eclipse_row ), dimension (:), allocatable , intent ( out ) :: rows real ( wp ), intent ( out ) :: phimin !! the smallest shadow function (no bubble) along the trajectory real ( wp ), intent ( out ) :: shadow_min !! the time in the shadow [min] (approximate: the number of points !! in the shadow times the step) integer :: n_segs , iseg , i , n , n_full , nk , kmax , nr real ( wp ), dimension (:), allocatable :: seg_phimin , seg_lo , seg_hi integer , dimension (:), allocatable :: seg_nshadow , full2red , removed logical , dimension (:), allocatable :: seg_near real ( wp ) :: dt , phi0 , phib , step real ( wp ), dimension ( 6 ) :: rv call mission % define_problem_size ( n_segs = n_segs ) call mission % define_problem_size ( n = n_full , full_problem = . true .) call mission % put_x_in_segments ( x ) allocate ( seg_phimin ( n_segs ), seg_lo ( n_segs ), seg_hi ( n_segs ), seg_nshadow ( n_segs ), seg_near ( n_segs )) seg_phimin = huge ( one ); seg_lo = huge ( one ); seg_hi = - huge ( one ); seg_nshadow = 0 ; seg_near = . false . !$OMP PARALLEL DO PRIVATE(iseg,i,n,dt,phi0,phib,rv) SCHEDULE(dynamic) do iseg = 1 , n_segs associate ( seg => mission % segs ( iseg )) call seg % traj_inertial % destroy () call seg % traj_rotating % destroy () call seg % traj_se_rotating % destroy () call seg % propagate ( mode = 2 , tstep = mission % eclipse_opt_detect_step ) n = size ( seg % traj_inertial % et ) do i = 1 , n rv = [ seg % traj_inertial % x ( i ), seg % traj_inertial % y ( i ), seg % traj_inertial % z ( i ), & seg % traj_inertial % vx ( i ), seg % traj_inertial % vy ( i ), seg % traj_inertial % vz ( i )] phi0 = get_sun_fraction ( seg % eph , seg % traj_inertial % et ( i ), rv , zero ) if ( mission % eclipse_opt_bubble > zero ) then phib = get_sun_fraction ( seg % eph , seg % traj_inertial % et ( i ), rv , mission % eclipse_opt_bubble ) else phib = phi0 end if seg_phimin ( iseg ) = min ( seg_phimin ( iseg ), phi0 ) if ( phi0 < zero ) seg_nshadow ( iseg ) = seg_nshadow ( iseg ) + 1 if ( phib < mission % eclipse_opt_detect_phi ) then dt = abs ( seg % traj_inertial % et ( i ) - seg % traj_inertial % et ( 1 )) ! [sec from the start] seg_near ( iseg ) = . true . seg_lo ( iseg ) = min ( seg_lo ( iseg ), dt ) seg_hi ( iseg ) = max ( seg_hi ( iseg ), dt ) end if end do call seg % traj_inertial % destroy () call seg % traj_rotating % destroy () call seg % traj_se_rotating % destroy () end associate end do !$OMP END PARALLEL DO phimin = minval ( seg_phimin ) shadow_min = real ( sum ( seg_nshadow ), wp ) * mission % eclipse_opt_detect_step / 6 0.0_wp ! the map from the full problem's columns to x: removed = mission % removed_columns () allocate ( full2red ( n_full )) full2red = 0 nk = 0 do i = 1 , n_full if ( any ( removed == i )) cycle nk = nk + 1 full2red ( i ) = nk end do ! the rows: the samples across the near-shadow part of each flagged segment, padded by one ! sample on each side (and not past the segment's last full step) step = mission % eclipse_opt_sample_step allocate ( rows ( count ( seg_near ))) nr = 0 do iseg = 1 , n_segs if (. not . seg_near ( iseg )) cycle associate ( seg => mission % segs ( iseg )) kmax = floor ( abs ( seg % data % tf - seg % data % t0 ) * day2sec / step - 1.0e-6_wp ) nr = nr + 1 rows ( nr )% iseg = iseg rows ( nr )% k_lo = max ( 0 , floor ( seg_lo ( iseg ) / step ) - 1 ) rows ( nr )% k_hi = min ( kmax , ceiling ( seg_hi ( iseg ) / step ) + 1 ) call row_columns ( iseg , full2red , rows ( nr )) end associate end do end subroutine find_rows","tags":"","url":"proc/find_rows.html"},{"title":"row_columns – halo","text":"subroutine row_columns(iseg, full2red, row) The variables a row of segment iseg depends on: the epoch and state of its start node. Arguments Type Intent Optional Attributes Name integer, intent(in) :: iseg integer, intent(in), dimension(:) :: full2red type( eclipse_row ), intent(inout) :: row Called by proc~~row_columns~~CalledByGraph proc~row_columns row_columns proc~find_rows find_rows proc~find_rows->proc~row_columns proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~find_rows interface~eclipse_optimize my_solver_type%eclipse_optimize interface~eclipse_optimize->proc~eclipse_optimize proc~halo_solver_main halo_solver_main proc~halo_solver_main->interface~eclipse_optimize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine row_columns ( iseg , full2red , row ) integer , intent ( in ) :: iseg integer , dimension (:), intent ( in ) :: full2red type ( eclipse_row ), intent ( inout ) :: row integer :: irev , l , js , ks , k , fc irev = ( iseg - 1 ) / 8 l = iseg - 8 * irev js = 4 * irev + start_node ( l ) ks = 4 * irev + tf_node ( l ) row % tf_with_t0 = ks == js row % ncol = 0 do k = 1 , 7 fc = 7 * ( js - 1 ) + k if ( full2red ( fc ) > 0 ) then row % ncol = row % ncol + 1 row % col ( row % ncol ) = full2red ( fc ) row % kind ( row % ncol ) = k - 1 end if end do end subroutine row_columns","tags":"","url":"proc/row_columns.html"},{"title":"merge_rows – halo","text":"subroutine merge_rows(rows, new) Add the new rows: a segment already in the list gets the union of the sample ranges. Arguments Type Intent Optional Attributes Name type( eclipse_row ), intent(inout), dimension(:), allocatable :: rows type( eclipse_row ), intent(in), dimension(:) :: new Called by proc~~merge_rows~~CalledByGraph proc~merge_rows merge_rows proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~merge_rows interface~eclipse_optimize my_solver_type%eclipse_optimize interface~eclipse_optimize->proc~eclipse_optimize proc~halo_solver_main halo_solver_main proc~halo_solver_main->interface~eclipse_optimize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine merge_rows ( rows , new ) type ( eclipse_row ), dimension (:), allocatable , intent ( inout ) :: rows type ( eclipse_row ), dimension (:), intent ( in ) :: new integer :: k , j logical :: found do k = 1 , size ( new ) found = . false . do j = 1 , size ( rows ) if ( rows ( j )% iseg == new ( k )% iseg ) then rows ( j )% k_lo = min ( rows ( j )% k_lo , new ( k )% k_lo ) rows ( j )% k_hi = max ( rows ( j )% k_hi , new ( k )% k_hi ) found = . true . exit end if end do if (. not . found ) rows = [ rows , new ( k )] end do end subroutine merge_rows","tags":"","url":"proc/merge_rows.html"},{"title":"report_change – halo","text":"subroutine report_change(mission, x0, x) Print how far the optimization moved the solution. Arguments Type Intent Optional Attributes Name class( mission_type ), intent(inout) :: mission real(kind=wp), intent(in), dimension(:) :: x0 real(kind=wp), intent(in), dimension(:) :: x Calls proc~~report_change~~CallsGraph proc~report_change report_change proc~define_problem_size mission_type%define_problem_size proc~report_change->proc~define_problem_size proc~removed_columns mission_type%removed_columns proc~report_change->proc~removed_columns proc~removed_columns->proc~define_problem_size Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~report_change~~CalledByGraph proc~report_change report_change proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~report_change interface~eclipse_optimize my_solver_type%eclipse_optimize interface~eclipse_optimize->proc~eclipse_optimize proc~halo_solver_main halo_solver_main proc~halo_solver_main->interface~eclipse_optimize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine report_change ( mission , x0 , x ) class ( mission_type ), intent ( inout ) :: mission real ( wp ), dimension (:), intent ( in ) :: x0 , x integer :: i , n_full , k , cc integer , dimension (:), allocatable :: removed real ( wp ) :: dt_max , dr_max , dv_max , d call mission % define_problem_size ( n = n_full , full_problem = . true .) removed = mission % removed_columns () dt_max = zero ; dr_max = zero ; dv_max = zero k = 0 do i = 1 , n_full if ( any ( removed == i )) cycle k = k + 1 d = abs ( x ( k ) - x0 ( k )) * mission % xscale ( k ) ! unscaled cc = mod ( i - 1 , 7 ) + 1 select case ( cc ) case ( 1 ); dt_max = max ( dt_max , d ) case ( 2 : 4 ); dr_max = max ( dr_max , d ) case ( 5 : 7 ); dv_max = max ( dv_max , d ) end select end do write ( * , '(A,F10.3,A,F12.3,A,F10.3,A)' ) '   largest change of a node: ' , dt_max * 2 4.0_wp , ' h in epoch, ' , & dr_max , ' km in position, ' , dv_max * 100 0.0_wp , ' m/s in velocity' end subroutine report_change","tags":"","url":"proc/report_change.html"},{"title":"get_rv – halo","text":"private  function get_rv(me, et) result(rv) Type Bound body_eph_interface Arguments Type Intent Optional Attributes Name class( body_eph_interface ), intent(inout) :: me real(kind=wp), intent(in) :: et ephemeris time (sec) Return Value real(kind=wp), dimension(6) position/velocity vector Calls proc~~get_rv~~CallsGraph proc~get_rv body_eph_interface%get_rv db1val db1val proc~get_rv->db1val Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point f