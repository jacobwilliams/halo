bmodule of an interface in a parent module. Source Code subroutine equilibrate ( d , x ) type ( eclipse_opt_data ), intent ( inout ) :: d real ( wp ), dimension (:), intent ( in ) :: x real ( wp ), dimension (:), allocatable :: jac , a , norms integer :: it , k call d % mission % compute_jacobian_stm ( x , jac ) allocate ( a ( size ( jac )), norms ( max ( size ( d % r ), size ( d % w )))) d % r = one d % w = one do it = 1 , 10 a = jac * d % r ( d % icol ) * d % w ( d % irow ) norms = zero do k = 1 , size ( a ) norms ( d % irow ( k )) = norms ( d % irow ( k )) + a ( k ) ** 2 end do where ( norms ( 1 : size ( d % w )) > zero ) d % w = d % w / sqrt ( norms ( 1 : size ( d % w ))) a = jac * d % r ( d % icol ) * d % w ( d % irow ) norms = zero do k = 1 , size ( a ) norms ( d % icol ( k )) = norms ( d % icol ( k )) + a ( k ) ** 2 end do where ( norms ( 1 : size ( d % r )) > zero ) d % r = d % r / sqrt ( norms ( 1 : size ( d % r ))) end do write ( * , '(A,2ES10.2,A,2ES10.2)' ) '   equilibrated: column factors ' , minval ( d % r ), maxval ( d % r ), & ', row weights ' , minval ( d % w ), maxval ( d % w ) end subroutine equilibrate","tags":"","url":"proc/equilibrate.html"},{"title":"union_columns – halo","text":"subroutine union_columns(d) With single : the columns of the single eclipse row (the union of the segment rows'),\nand where each segment row's column is in them. Arguments Type Intent Optional Attributes Name type( eclipse_opt_data ), intent(inout) :: d Called by proc~~union_columns~~CalledByGraph proc~union_columns union_columns proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~union_columns interface~eclipse_optimize my_solver_type%eclipse_optimize interface~eclipse_optimize->proc~eclipse_optimize proc~halo_solver_main halo_solver_main proc~halo_solver_main->interface~eclipse_optimize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine union_columns ( d ) type ( eclipse_opt_data ), intent ( inout ) :: d integer :: k , j , o , i , nu if ( allocated ( d % ucol )) deallocate ( d % ucol ) if ( allocated ( d % upos )) deallocate ( d % upos ) allocate ( d % ucol ( sum ( d % rows % ncol )), d % upos ( sum ( d % rows % ncol ))) nu = 0 o = 0 do k = 1 , size ( d % rows ) do j = 1 , d % rows ( k )% ncol i = findloc ( d % ucol ( 1 : nu ), d % rows ( k )% col ( j ), 1 ) if ( i == 0 ) then nu = nu + 1 d % ucol ( nu ) = d % rows ( k )% col ( j ) i = nu end if d % upos ( o + j ) = i end do o = o + d % rows ( k )% ncol end do d % ucol = d % ucol ( 1 : nu ) end subroutine union_columns","tags":"","url":"proc/union_columns.html"},{"title":"scale_row_columns – halo","text":"subroutine scale_row_columns(d, jac) Multiply the eclipse rows' partials by the optimization's variable scaling r . Arguments Type Intent Optional Attributes Name type( eclipse_opt_data ), intent(in) :: d real(kind=wp), intent(inout), dimension(:) :: jac Called by proc~~scale_row_columns~~CalledByGraph proc~scale_row_columns scale_row_columns proc~eclipse_gjac eclipse_gjac proc~eclipse_gjac->proc~scale_row_columns Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine scale_row_columns ( d , jac ) type ( eclipse_opt_data ), intent ( in ) :: d real ( wp ), dimension (:), intent ( inout ) :: jac integer :: k , j , o o = 0 do k = 1 , size ( d % rows ) do j = 1 , d % rows ( k )% ncol jac ( o + j ) = jac ( o + j ) * d % r ( d % rows ( k )% col ( j )) end do o = o + d % rows ( k )% ncol end do end subroutine scale_row_columns","tags":"","url":"proc/scale_row_columns.html"},{"title":"find_rows – halo","text":"subroutine find_rows(mission, x, rows, phimin, shadow_min) Check the shadow function along the whole trajectory (every eclipse_opt_detect_step seconds), and make the rows of the segments that come near the shadow (where the shadow\nfunction, with the constraints' bubble, is below eclipse_opt_detect_phi ). Arguments Type Intent Optional Attributes Name class( mission_type ), intent(inout) :: mission real(kind=wp), intent(in), dimension(:) :: x type( eclipse_row ), intent(out), dimension(:), allocatable :: rows real(kind=wp), intent(out) :: phimin the smallest shadow function (no bubble) along the trajectory real(kind=wp), intent(out) :: shadow_min the time in the shadow [min] (approximate: the number of points\nin the shadow times the step) Calls proc~~find_rows~~CallsGraph proc~find_rows find_rows proc~define_problem_size mission_type%define_problem_size proc~find_rows->proc~define_problem_size proc~destroy_trajectory trajectory%destroy_trajectory proc~find_rows->proc~destroy_trajectory proc~get_sun_fraction get_sun_fraction proc~find_rows->proc~get_sun_fraction proc~propagate_segment segment%propagate_segment proc~find_rows->proc~propagate_segment proc~put_x_in_segments mission_type%put_x_in_segments proc~find_rows->proc~put_x_in_segments proc~removed_columns mission_type%removed_columns proc~find_rows->proc~removed_columns proc~row_columns row_columns proc~find_rows->proc~row