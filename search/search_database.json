an interface in a parent module. Source Code subroutine halo_export ( me , x , f , iter ) use iso_fortran_env , ip => int64 implicit none class ( nlesolver_type ), intent ( inout ) :: me real ( wp ), dimension (:), intent ( in ) :: x real ( wp ), dimension (:), intent ( in ) :: f integer , intent ( in ) :: iter !! iteration number integer ( ip ), save :: count_start , count_end , count_rate call system_clock ( count = count_end , count_rate = count_rate ) if ( iter == 1 ) then write ( * , '(A4,1X,*(A30,1X))' ) 'ITER' , 'NORM(X)' , 'NORM(F)' , 'DT(sec)' end if if ( iter == 1 ) then write ( * , '(I4,1X,2(F30.16,1X),a1)' ) iter , norm2 ( x ), norm2 ( f ), '' else write ( * , '(I4,1X,2(F30.16,1X),*(I30,1x))' ) iter , norm2 ( x ), norm2 ( f ), & int (( count_end - count_start ) / real ( count_rate , wp ), ip ) end if !write(*,'(I4,1X,*(F30.16,1X))') iter, x count_start = count_end ! send this iteration's trajectory to the callback (e.g., to plot it): select type ( me ) class is ( my_solver_type ) if ( associated ( me % iteration_callback )) call iteration_trajectory ( me , x , iter ) if ( associated ( me % epoch_callback )) call iteration_epochs ( me , x , iter ) end select !select type (me) !class is (my_solver_type) !    write(*,*) 'rdot = ', compute_rdot(me%mission%segs(1)%data%x0) !end select end subroutine halo_export","tags":"","url":"proc/halo_export.html"},{"title":"iteration_epochs – halo","text":"public  subroutine iteration_epochs(me, x, iter) Send the epochs at the constraint points (where segments 2k-1 and 2k end) for\nthe solver's current x to the solver's epoch_callback . Arguments Type Intent Optional Attributes Name class( my_solver_type ), intent(inout) :: me real(kind=wp), intent(in), dimension(:) :: x the solver's (scaled) opt vars for this iteration integer, intent(in) :: iter iteration number Calls proc~~iteration_epochs~~CallsGraph proc~iteration_epochs iteration_epochs proc~put_x_in_segments mission_type%put_x_in_segments proc~iteration_epochs->pr