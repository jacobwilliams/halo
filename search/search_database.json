 optional :: n_nonzero number of nonzero elements in the Jacobian logical, intent(in), optional :: full_problem if true (default) always return the results for the full problem\n(i.e., without fixing any of the variables) Called by proc~~define_problem_size~~CalledByGraph proc~define_problem_size mission_type%define_problem_size proc~compute_jacobian_stm mission_type%compute_jacobian_stm proc~compute_jacobian_stm->proc~define_problem_size proc~get_sparsity_pattern mission_type%get_sparsity_pattern proc~compute_jacobian_stm->proc~get_sparsity_pattern proc~put_x_in_segments mission_type%put_x_in_segments proc~compute_jacobian_stm->proc~put_x_in_segments proc~removed_columns mission_type%removed_columns proc~compute_jacobian_stm->proc~removed_columns proc~eclipse_optimize eclipse_optimize proc~eclipse_optimize->proc~define_problem_size proc~find_rows find_rows proc~eclipse_optimize->proc~find_rows proc~eclipse_optimize->proc~get_sparsity_pattern proc~eclipse_optimize->proc~put_x_in_segments proc~report_change report_change proc~eclipse_optimize->proc~report_change proc~step_limits step_limits proc~eclipse_optimize->proc~step_limits proc~constraint_violations mission_type%constraint_violations proc~eclipse_optimize->proc~constraint_violations proc~equilibrate equilibrate proc~eclipse_optimize->proc~equilibrate proc~newton_finish newton_finish proc~eclipse_optimize->proc~newton_finish proc~find_rows->proc~define_problem_size proc~find_rows->proc~put_x_in_segments proc~find_rows->proc~removed_columns proc~get_scales_from_segs mission_type%get_scales_from_segs proc~get_scales_from_segs->proc~define_problem_size proc~get_sparsity_pattern->proc~define_problem_size proc~get_sparsity_pattern->proc~removed_columns proc~halo_solver_main halo_solver_main proc~halo_solver_main->proc~define_problem_size proc~initialize_the_solver my_solver_type%initialize_the_solver proc~halo_solver_main->proc~initialize_the_solver proc~print_constraint_defects mission_type%print_constraint_defects proc~halo_solver_main->proc~print_constraint_defects proc~halo_solver_main->proc~put_x_in_segments proc~write_solution_plot_data mission_type%write_solution_plot_data proc~halo_solver_main->proc~write_solution_plot_data interface~eclipse_optimize my_solver_type%eclipse_optimize proc~halo_solver_main->interface~eclipse_optimize proc~halo_solver_main->proc~constraint_violations proc~initialize_the_mission mission_type%initialize_the_mission proc~initialize_the_mission->proc~define_problem_size proc~initialize_the_mission->proc~get_scales_from_segs proc~initialize_the_mission->proc~get_sparsity_pattern proc~equilibrate_scales mission_type%equilibrate_scales proc~initialize_the_mission->proc~equilibrate_scales proc~initialize_the_solver->proc~define_problem_size proc~initialize_the_solver->proc~get_sparsity_pattern proc~initialize_the_solver->proc~initialize_the_mission proc~initialize_the_solver->proc~put_x_in_segments proc~print_constraint_defects->proc~define_problem_size proc~put_x_in_segments->proc~define_problem_size proc~removed_columns->proc~define_problem_size proc~report_change->proc~define_problem_size proc~report_change->proc~removed_columns proc~segs_to_propagate mission_type%segs_to_propagate proc~segs_to_propagate->proc~define_problem_size proc~step_limits->proc~define_problem_size proc~step_limits->proc~removed_columns proc~write_solution_plot_data->proc~define_problem_size proc~write_solution_plot_data->proc~constraint_violations interface~eclipse_optimize->proc~eclipse_optimize proc~constraint_violations->proc~put_x_in_segments proc~constraint_violations->proc~segs_to_propagate proc~equilibrate->proc~compute_jacobian_stm proc~equilibrate_scales->proc~compute_jacobian_stm proc~equilibrate_scales->proc~get_sparsity_pattern proc~iteration_epochs iteration_epochs proc~iteration_epochs->proc~put_x_in_segments proc~iteration_trajectory iteration_trajectory proc~iteration_trajectory->proc~put_x_in_segments proc~newton_finish->proc~get_sparsity_pattern proc~newton_finish->proc~put_x_in_segments proc~halo_export halo_export proc~halo_export->proc~iteration_epochs proc~halo_export->proc~iteration_trajectory Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine define_problem_size ( me , n , m , n_segs , n_nonzero , full_problem ) implicit none class ( mission_type ), intent ( in ) :: me integer , intent ( out ), optional :: n !! number of opt vars for the solver integer , intent ( out ), optional :: m !! number of equality constraints for the solver integer , intent ( out ), optional :: n_segs !! number of segments integer , intent ( out ), optional :: n_nonzero !! number of nonzero elements in the Jacobian logical , intent ( in ), optional :: full_problem !! if true (default) always return the results for the full problem !! (i.e., without fixing any of the variables) if ( present ( n )) n = 28 * me % n_revs + 7 if ( present ( m )) m = 24 * me % n_revs if ( present ( n_segs )) n_segs = 8 * me % n_revs ! there are 4 blocks of nonzeros per rev ! (each block contains 84 elements) if ( present ( n_nonzero )) then n_nonzero = me % n_revs * ( 84 * 4 ) if ( me % constrain_initial_rdot ) then if ( me % fix_initial_r ) then ! add elements (rdot is function of initial r,v) n_nonzero = n_nonzero + 3 ! only v is in the opt var vec else n_nonzero = n_nonzero + 6 ! r,v in opt var vec end if end if end if ! optional rdot constraint if ( me % constrain_initial_rdot ) then if ( present ( m )) m = m + 1 ! add one function (the last row) end if if ( present ( full_problem )) then if ( full_problem ) return ! don't do the stuff below end if if ( me % fix_initial_time ) then if ( present ( n )) n = n - 1 ! remove the t0 optimization variable if ( present ( n_nonzero )) n_nonzero = n_nonzero - 6 ! remove the first column of the jacobian end if if ( me % fix_initial_r ) then if ( present ( n )) n = n - 3 ! remove the three optimization variables if ( present ( n_nonzero )) n_nonzero = n_nonzero - 3 * 6 ! remove columns 2,3,4 of the jacobian end if ! note: assuming there are more than 2 revs for these if ( me % fix_ry_at_end_of_rev > 0 ) then if ( me % n_revs < 3 ) error stop 'at least 3 revs are required for fix_ry_at_end_of_rev' if ( me % fix_ry_at_end_of_rev >= me % n_revs ) & error stop 'fix_ry_at_end_of_rev must be < number of revs' if ( present ( n )) n = n - 1 ! remove the optimization variable if ( present ( n_nonzero )) n_nonzero = n_nonzero - 12 end if if ( me % fix_final_ry_and_vx ) then if ( me % n_revs < 3 ) error stop 'at least 3 revs are required for fix_final_ry_and_vx' if ( present ( n )) n = n - 2 ! remove the two optimization variable if ( present ( n_nonzero )) n_nonzero = n_nonzero - 2 * 6 end if end subroutine define_problem_size","tags":"","url":"proc/define_problem_size.html"},{"title":"put_data_in_segment – halo","text":"public  subroutine put_data_in_segment(me, d) Set all the data in a segment. Type Bound segment Arguments Type Intent Optional Attributes Name class( segment ), intent(inout) :: me type( segment_data ), intent(in) :: d Source Code subroutine put_data_in_segment ( me , d ) implicit none class ( segment ), intent ( inout ) :: me type ( segment_data ), intent ( in ) :: d me % data = d me % cached_data = d ! also the cache end subroutine put_data_in_segment","tags":"","url":"proc/put_data_in_segment.html"},{"title":"cache – halo","text":"public  subroutine cache(me) Cache all the data in a segment. Type Bound segment Arguments Type Intent Op